# Copy to .env.local. This file must contain examples only.
# Local PHP practice does not require AWS credentials.
# Variables here are passed only to the PHP container at runtime.

# Defaults already work with the bundled local database.
# Changing this alone does not change the existing MySQL user's password.
# ISUCON13_MYSQL_DIALCONFIG_PASSWORD=isucon

# Optional: only if you later add an AWS integration to PHP.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=ap-northeast-1
